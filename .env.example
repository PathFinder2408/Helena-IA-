# Copiar a .env y completar (NUNCA subir .env a git)
ASSISTANT_NAME=Helena
WAKE_WORD=Helena
CITY=Santiago,CL
USER_STACK=JavaScript fullstack, Django, Python

# Rutas opcionales a tus proyectos locales
HELENA_PROJECTS_DIR=
HELENA_CV_PROJECT=
HELENA_CV_FILE=

# Cerebro local offline (Ollama en GPU NVIDIA / CPU)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=helena

# Configuración de voz (Paloma #4 nativa 100% español; Vivienne #3 alternativa)
VOICE_BACKEND=auto
WHISPER_MODEL=small
WHISPER_DEVICE=auto
TTS_ENGINE=edge
TTS_VOICE=es-US-PalomaNeural
TTS_RATE=+0%
TTS_PITCH=-1Hz
FOLLOWUP_SEC=6.5

# API Keys opcionales (si faltan, Helena usa Ollama local automáticamente)
GEMINI_API_KEY=
GEMINI_VOICE_MODEL=gemini-2.5-flash
GEMINI_TTS_VOICE=Aoede
OPENWEATHER_API_KEY=
GITHUB_TOKEN=
